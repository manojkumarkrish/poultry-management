# =========================================================================
# KASTHURI POULTRY FARM (KPF) — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local for local development.
# In Vercel / Production, configure these under Settings -> Environment Variables.
# =========================================================================

# 1. Supabase PostgreSQL Configuration
# Retrieve from Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Application Mode
# 'production' = Connected to Supabase PostgreSQL cloud database
# 'hybrid'     = Local persistence engine (instant operation & offline resilience)
NEXT_PUBLIC_APP_MODE=production

# 3. Production Site URL
# Set to your production domain (used for auth callbacks and password resets)
NEXT_PUBLIC_SITE_URL=https://poultry-management.vercel.app

# 4. Security & Cryptographic Session Signing (Optional)
# 64-character secret for HMAC session signing. If omitted, system defaults to secure built-in farm key.
# SESSION_SECRET=your-64-character-random-hex-string
